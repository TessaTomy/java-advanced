<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="PixelController"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 100%, #001a33 0%, #00050a 100%);">

    <!-- Top: Title + unified toolkit -->
    <top>
        <VBox alignment="CENTER" spacing="15">
            <padding><Insets top="30" bottom="15"/></padding>

            <!-- Title -->
            <Label text="Pixel Art Generator"
                   style="-fx-font-family: 'Bradley Hand ITC'; -fx-font-size: 42; -fx-text-fill: #ffff00; -fx-font-weight: bold;
                          -fx-effect: dropshadow(gaussian, rgba(255, 255, 0, 0.4), 10, 0, 0, 0);"/>

            <!-- Unified toolkit container -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-padding: 15; -fx-background-color: rgba(0, 10, 25, 0.9); -fx-background-radius: 15;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 20, 0, 0, 10);
                         -fx-border-color: #3a6186; -fx-border-radius: 15; -fx-max-width: 880;">

                <!-- First row: canvas size + generate + color + save -->
                <HBox alignment="CENTER" spacing="20">
                    <Label text="Canvas Size:" style="-fx-text-fill: #fff3a0; -fx-font-family: 'Segoe Script'; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    
                    <!-- Slim minimalist slider -->
                    <Slider fx:id="gridSize" min="16" max="64" value="20" prefWidth="220"
                        style="
                            -fx-background-color: transparent;
                            -fx-cursor: hand;

                            /* Track styling */
                            -fx-control-inner-background: #001a33;
                            -fx-track-color: #001a33;
                            -fx-background-radius: 5;
                            -fx-padding: 6;
                        "/>
                    
                    <Label fx:id="sizeValue" text="20 x 20" style="-fx-text-fill: #fff3a0; -fx-font-family: 'Segoe Script'; -fx-font-size:16; -fx-font-weight: bold;"/>
                    
                    <Button text="Generate" onAction="#handleGenerate"
                            style="-fx-font-family: 'Segoe Script'; -fx-font-size: 20; -fx-font-weight: bolder;
                                   -fx-background-color: linear-gradient(to bottom right, #19334b, #ffff00);
                                   -fx-text-fill: #001a33; -fx-background-radius: 10; -fx-padding: 5 12; -fx-cursor: hand;"/>
                    
                    <ColorPicker fx:id="colorPicker"
                                 style="-fx-background-color: transparent; -fx-color-label-visible: false; -fx-cursor: hand;"/>
                    
                    <!-- Save icon -->
                    <Button text="Save 💾" onAction="#handleSave"
                            style="-fx-font-family: 'Segoe Script';-fx-font-size: 20; -fx-background-color: #001224; -fx-text-fill: #fff3a0;
                                   -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 6 12; -fx-cursor: hand;">
                        <tooltip><Tooltip text="Save"/></tooltip>
                    </Button>
                </HBox>

                <!-- Second row: eraser + clear + undo/redo -->
                <HBox alignment="CENTER" spacing="20">
                    <ToggleButton fx:id="eraserBtn" text="Eraser"
                                  style="-fx-font-family: 'Segoe Script'; -fx-font-size: 18; -fx-font-weight: bold;
                                         -fx-background-color: #001224; -fx-text-fill: #fff3a0;
                                         -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;"/>
                    
                    <Button text="✖ Clear" onAction="#handleClear"
                            style="-fx-font-family: 'Segoe Script'; -fx-font-size: 18; -fx-font-weight: bold;
                                   -fx-background-color: #001224; -fx-text-fill: #fff3a0;
                                   -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;"/>
                    
                    <!-- Undo icon -->
                    <Button text="↶" onAction="#handleUndo"
                            style="-fx-font-size: 22; -fx-background-color: #001224; -fx-text-fill: #fff3a0;
                                   -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 6 12; -fx-cursor: hand;">
                        <tooltip><Tooltip text="Undo"/></tooltip>
                    </Button>
                    
                    <!-- Redo icon -->
                    <Button text="↷" onAction="#handleRedo"
                            style="-fx-font-size: 22; -fx-background-color: #001224; -fx-text-fill: #fff3a0;
                                   -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 6 12; -fx-cursor: hand;">
                        <tooltip><Tooltip text="Redo"/></tooltip>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <!-- Center: Canvas -->
    <center>
        <StackPane>
            <padding><Insets top="10" bottom="40" left="20" right="20"/></padding>
            <GridPane fx:id="gridContainer" alignment="CENTER"
                      style="-fx-effect: dropshadow(three-pass-box, rgba(58, 97, 134, 0.3), 30, 0, 0, 0);"/>
        </StackPane>
    </center>
</BorderPane>
