<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="PixelController" 
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 100%, #001a33 0%, #00050a 100%);">
    <top>
        <VBox alignment="CENTER" spacing="12">
            <padding><Insets top="30" bottom="15"/></padding>
            
            <Label text="Pixel Art Generator" 
                   style="-fx-font-family: 'Bradley Hand ITC'; -fx-font-size: 42; -fx-text-fill: #ffff00; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(255, 255, 0, 0.4), 10, 0, 0, 0);"/>
            
            <HBox alignment="CENTER" spacing="20" 
                  style="-fx-padding: 18 25; -fx-background-color: rgba(0, 10, 25, 0.9); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 20, 0, 0, 10); -fx-border-color: #3a6186; -fx-border-radius: 15; -fx-max-width: 880;">
                
                <HBox alignment="CENTER" spacing="12">
                    <Label text="Canvas Size:" style="-fx-text-fill: #fff3a0; -fx-font-family: 'Kristen ITC'; -fx-font-size: 15; -fx-font-weight: bold;"/>
                    <Slider fx:id="gridSize" min="16" max="64" value="20" prefWidth="160" style="-fx-opacity: 0.9; -fx-cursor: hand;"/>
                    <Label fx:id="sizeValue" text="20 x 20" style="-fx-text-fill: #fff3a0; -fx-font-family: 'Kristen ITC'; -fx-font-size: 15; -fx-font-weight: bold;"/>
                </HBox>
                
                <Separator orientation="VERTICAL" prefHeight="25" style="-fx-opacity: 0.2;"/>
                
                <HBox alignment="CENTER" spacing="15">
                    <ColorPicker fx:id="colorPicker" 
                                 style="-fx-background-color: transparent; -fx-color-label-visible: false; -fx-cursor: hand;"/>
                    
                    <ToggleButton fx:id="eraserBtn" text="Eraser [E]" 
                                  style="-fx-font-family: 'Kristen ITC'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #001224; -fx-text-fill: #fff3a0; -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;"/>
                    
                    <Button text="Clear [C]" onAction="#handleClear" 
                            style="-fx-font-family: 'Kristen ITC'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #001224; -fx-text-fill: #fff3a0; -fx-border-color: #3a6186; -fx-border-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;"/>
                    
                    <Button text="Generate" onAction="#handleGenerate" 
                            style="-fx-font-family: 'Kristen ITC'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: linear-gradient(to bottom right, #3a6186, #ffff00); -fx-text-fill: #001a33; -fx-background-radius: 10; -fx-padding: 10 22; -fx-cursor: hand;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <StackPane>
            <padding><Insets top="10" bottom="40" left="20" right="20"/></padding>
            <GridPane fx:id="gridContainer" alignment="CENTER" 
                      style="-fx-effect: dropshadow(three-pass-box, rgba(58, 97, 134, 0.3), 30, 0, 0, 0);"/>
        </StackPane>
    </center>
</BorderPane>